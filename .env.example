# Optional path to a Google service account key file.
# Application Default Credentials are used when this variable is omitted.
GSC_CREDENTIALS_FILE=

# Comma-separated Search Console properties that the server may access.
# Example: sc-domain:example.com,https://www.example.com/
GSC_ALLOWED_SITES=

# Write tools are disabled unless explicitly enabled.
GSC_ENABLE_WRITE_TOOLS=false

# Request controls.
GSC_REQUEST_TIMEOUT_MS=30000
GSC_MAX_RETRIES=2
GSC_MAX_ANALYTICS_ROWS=25000
GSC_LOG_LEVEL=info
